{
  "name": "project-lsp",
  "version": "1.0.0",
  "description": "Worktree-local TypeScript and Python language servers for Dispatches.",
  "author": { "name": "Dispatches contributors" },
  "lspServers": {
    "typescript": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/node_modules/typescript-language-server/lib/cli.mjs",
        "--stdio"
      ],
      "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    },
    "python": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/node_modules/pyright/langserver.index.js",
        "--stdio"
      ],
      "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
      "settings": {
        "python": {
          "analysis": {
            "diagnosticMode": "openFilesOnly"
          }
        }
      },
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  }
}
