---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import SocialLinks from "@components/SocialLinks.astro";
import { getListOGData } from "@lib/opengraph";

const title = "About";
const description = "About Dispatches and its author";
const ogData = getListOGData(
  title,
  description,
  Astro.url.toString(),
  Astro.site?.toString() || ""
);
---

<PageLayout title={title} description={description} ogData={ogData}>
  <Container>
    <div class="space-y-10">
      <h1 class="font-semibold text-fg-strong">
        About
      </h1>

      <div class="space-y-4">
        <section class="space-y-4">
          <h2 class="font-semibold text-fg-strong">About Dispatches</h2>
          <article class="prose dark:prose-invert">
            <p>
              <em>Dispatches</em> is where I publish technical writing on topics of personal interest.
              During this initial phase, much of the content will be "refurbished-and-expanded": older
              personal notes or explanations, updated and expanded where necessary.
            </p>
            <p>
              Expect a focus on Swift, lower-level iOS work, and—as of late—agentic coding assistants.
            </p>
          </article>
        </section>

        <section class="space-y-4">
          <h2 class="font-semibold text-fg-strong">Connect</h2>
          <article>
            <p class="mb-4">Feel free to reach out:</p>
            <SocialLinks />
          </article>
        </section>
      </div>
    </div>
  </Container>
</PageLayout>
